# Copy this file to .env and set the connection information for your Arcus cluster.
# Run with: docker compose --env-file .env up --wait
# Compose references these values without fallback defaults.
# bootRun and java -jar do not load .env automatically.

# Existing Arcus cluster. Replace these example addresses and service code.
# ZooKeeper and its registered cache addresses must be reachable from the container.
ARCUS_ZOOKEEPER_ADDRESS=127.0.0.1:2181,127.0.0.1:2182,127.0.0.1:2183
ARCUS_SERVICE_CODE=test

# The same HTTP port is used by the application and published on the host.
ARCUS_HTTP_PORT=49686

# Arcus client settings.
ARCUS_POOL_SIZE=8
ARCUS_OPERATION_TIMEOUT_MS=700
